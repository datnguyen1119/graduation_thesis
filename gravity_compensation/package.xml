<?xml version="1.0"?>
<package format="3">
  <name>gravity_compensation</name>
  <version>0.1.0</version>
  <description>Gravity compensation library and node for robotic arm using Pinocchio</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>MIT</license>

  <!-- Build dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>can_odrive_interface</build_depend>
  <build_depend>pinocchio</build_depend>
  <build_depend>Eigen3</build_depend>

  <!-- Exec dependencies -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>can_odrive_interface</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>